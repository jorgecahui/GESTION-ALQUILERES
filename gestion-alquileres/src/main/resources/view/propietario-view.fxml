<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.ejemplo.alquileres.controller.JlccPropietarioController">
    <HBox spacing="18" styleClass="pagina">
        <VBox spacing="16" HBox.hgrow="ALWAYS">
            <HBox>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Propietarios" styleClass="pagina-titulo"/>
                    <Label text="Personas y empresas propietarias." styleClass="pagina-subtitulo"/>
                </VBox>
                <Button text="Nuevo propietario" onAction="#jlccOnNuevo" styleClass="boton-primario,requiere-gestion"/>
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="buscar" promptText="Buscar nombre o documento" HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="activos" text="Solo activos"/>
                <Button text="Editar" onAction="#jlccOnEditar" styleClass="requiere-gestion"/>
                <Button
                    fx:id="btnEliminarDesactivar"
                    text="Eliminar / desactivar"
                    onAction="#jlccOnEliminar"
                    styleClass="requiere-gestion"
                    visible="false"
                    managed="false"/>
                <Button
                    fx:id="btnReactivar"
                    text="Reactivar"
                    onAction="#jlccOnReactivar"
                    styleClass="requiere-gestion"
                    visible="false"
                    managed="false"/>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="tabla">
                <columns>
                    <TableColumn fx:id="colNombre" text="Propietario" prefWidth="220"/>
                    <TableColumn fx:id="colDocumento" text="Documento" prefWidth="170"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="140"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="210"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
    <Region
        fx:id="overlay"
        visible="false"
        managed="false"
        pickOnBounds="true"
        styleClass="overlay"
        onMouseClicked="#jlccOnCerrar"/>
    <VBox
        fx:id="drawer"
        visible="false"
        managed="false"
        prefWidth="560"
        minWidth="560"
        maxWidth="560"
        maxHeight="Infinity"
        styleClass="drawer,panel-formulario"
        StackPane.alignment="TOP_RIGHT">
        <HBox styleClass="drawer-header">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titulo" styleClass="drawer-titulo"/>
                <Label text="Datos del propietario" styleClass="drawer-subtitulo"/>
            </VBox>
            <Button onAction="#jlccOnCerrar" styleClass="drawer-cerrar" focusTraversable="false">
                <graphic>
                    <FontIcon iconLiteral="fth-x"/>
                </graphic>
                <tooltip>
                    <Tooltip text="Cerrar"/>
                </tooltip>
            </Button>
        </HBox>
        <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            VBox.vgrow="ALWAYS"
            styleClass="drawer-scroll">
            <VBox styleClass="drawer-body">
                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="40"/>
                        <ColumnConstraints percentWidth="60"/>
                    </columnConstraints>
                    <VBox styleClass="campo" GridPane.columnIndex="0">
                        <HBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Tipo de documento" styleClass="campo-label"/>
                            <Label text="*" styleClass="campo-requerido"/>
                        </HBox>
                        <ComboBox fx:id="tipo" promptText="Tipo" maxWidth="Infinity"/>
                        <Label fx:id="errorTipo" styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                    <VBox styleClass="campo" GridPane.columnIndex="1">
                        <HBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Documento" styleClass="campo-label"/>
                            <Label text="*" styleClass="campo-requerido"/>
                        </HBox>
                        <TextField fx:id="documento" promptText="Número de documento" maxWidth="Infinity"/>
                        <Label fx:id="errorDocumento" styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                </GridPane>
                <VBox styleClass="campo">
                    <HBox spacing="3" alignment="CENTER_LEFT">
                        <Label text="Nombre o razón social" styleClass="campo-label"/>
                        <Label text="*" styleClass="campo-requerido"/>
                    </HBox>
                    <TextField fx:id="nombre" promptText="Ej. Juan Pérez / Inmobiliaria SAC" maxWidth="Infinity"/>
                    <Label fx:id="errorNombre" styleClass="campo-error" visible="false" managed="false"/>
                </VBox>
                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <VBox styleClass="campo" GridPane.columnIndex="0">
                        <Label text="Teléfono" styleClass="campo-label"/>
                        <TextField fx:id="telefono" promptText="Ej. 999 888 777" maxWidth="Infinity"/>
                    </VBox>
                    <VBox styleClass="campo" GridPane.columnIndex="1">
                        <Label text="Email" styleClass="campo-label"/>
                        <TextField fx:id="email" promptText="correo@ejemplo.com" maxWidth="Infinity"/>
                    </VBox>
                </GridPane>
                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50"/>
                        <ColumnConstraints percentWidth="50"/>
                    </columnConstraints>
                    <VBox styleClass="campo" GridPane.columnIndex="0">
                        <Label text="Banco" styleClass="campo-label"/>
                        <TextField fx:id="banco" promptText="Banco (opcional)" maxWidth="Infinity"/>
                    </VBox>
                    <VBox styleClass="campo" GridPane.columnIndex="1">
                        <Label text="Cuenta / CCI" styleClass="campo-label"/>
                        <TextField fx:id="cuenta" promptText="Cuenta o CCI (opcional)" maxWidth="Infinity"/>
                    </VBox>
                </GridPane>
            </VBox>
        </ScrollPane>
        <HBox styleClass="drawer-footer">
            <Button text="Cancelar" onAction="#jlccOnCerrar" styleClass="button-outlined"/>
            <Button text="Guardar propietario" onAction="#jlccOnGuardar" styleClass="boton-primario,requiere-gestion"/>
        </HBox>
    </VBox>
</StackPane>
