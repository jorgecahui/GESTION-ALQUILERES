<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<VBox
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.ejemplo.alquileres.controller.ConfiguracionController"
    spacing="16"
    styleClass="pagina">
    <HBox spacing="12">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Configuración" styleClass="pagina-titulo"/>
            <Label
                text="Parámetros del arrendador, recibos, mora, alertas, semáforo y plantillas."
                styleClass="pagina-subtitulo"/>
        </VBox>
        <Label fx:id="estado" styleClass="pagina-subtitulo"/>
        <Button text="Guardar cambios" onAction="#onGuardar" styleClass="boton-primario,requiere-admin"/>
    </HBox>
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <Tab text="Arrendador">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="16" styleClass="pagina">
                    <GridPane hgap="14" vgap="12" maxWidth="820">
                        <columnConstraints>
                            <ColumnConstraints minWidth="190" prefWidth="210"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Razón social / nombre" styleClass="campo-label" GridPane.rowIndex="0"/>
                        <TextField
                            fx:id="razonSocial"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            maxWidth="Infinity"/>
                        <Label text="Tipo de documento" styleClass="campo-label" GridPane.rowIndex="1"/>
                        <TextField
                            fx:id="tipoDocumento"
                            promptText="RUC"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                        <Label text="Número de documento" styleClass="campo-label" GridPane.rowIndex="2"/>
                        <TextField
                            fx:id="documento"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"
                            maxWidth="Infinity"/>
                        <Label text="Dirección" styleClass="campo-label" GridPane.rowIndex="3"/>
                        <TextField
                            fx:id="direccion"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"
                            maxWidth="Infinity"/>
                        <Label text="Teléfono" styleClass="campo-label" GridPane.rowIndex="4"/>
                        <TextField fx:id="telefono" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>
                        <Label text="Correo electrónico" styleClass="campo-label" GridPane.rowIndex="5"/>
                        <TextField fx:id="email" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>
                        <Label text="Logo" styleClass="campo-label" GridPane.rowIndex="6"/>
                        <HBox spacing="8" GridPane.rowIndex="6" GridPane.columnIndex="1">
                            <TextField fx:id="logoArchivo" editable="false" promptText="Sin logo" HBox.hgrow="ALWAYS"/>
                            <Button text="Elegir…" onAction="#onElegirLogo" styleClass="requiere-admin"/>
                            <Button text="Quitar" onAction="#onQuitarLogo" styleClass="requiere-admin"/>
                        </HBox>
                    </GridPane>
                    <ImageView
                        fx:id="logoVista"
                        fitWidth="160"
                        fitHeight="70"
                        preserveRatio="true"
                        visible="false"
                        managed="false"/>
                    <Label
                        text="El logo se copia a la carpeta de datos y se usa en recibos, contratos y estados de cuenta."
                        styleClass="campo-ayuda"
                        wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Recibos">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="16" styleClass="pagina">
                    <GridPane hgap="14" vgap="12" maxWidth="820">
                        <columnConstraints>
                            <ColumnConstraints minWidth="190" prefWidth="210"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Serie del recibo" styleClass="campo-label" GridPane.rowIndex="0"/>
                        <TextField
                            fx:id="reciboSerie"
                            promptText="R001"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                        <Label text="Leyenda al pie" styleClass="campo-label" GridPane.rowIndex="1"/>
                        <TextArea
                            fx:id="reciboLeyenda"
                            prefRowCount="3"
                            wrapText="true"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"/>
                    </GridPane>
                    <Label
                        text="La serie se aplica a los nuevos recibos. Los ya emitidos conservan su numeración."
                        styleClass="campo-ayuda"
                        wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Mora">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="16" styleClass="pagina">
                    <GridPane hgap="14" vgap="12" maxWidth="820">
                        <columnConstraints>
                            <ColumnConstraints minWidth="190" prefWidth="210"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Tipo de mora por defecto" styleClass="campo-label" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="moraTipo" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="300"/>
                        <Label text="Valor" styleClass="campo-label" GridPane.rowIndex="1"/>
                        <TextField
                            fx:id="moraValor"
                            promptText="0.10"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                        <Label text="Días de gracia" styleClass="campo-label" GridPane.rowIndex="2"/>
                        <TextField
                            fx:id="moraDiasGracia"
                            promptText="3"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                    </GridPane>
                    <Label
                        text="Estos valores se copian a cada contrato nuevo y quedan congelados en él."
                        styleClass="campo-ayuda"
                        wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Alertas">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="16" styleClass="pagina">
                    <GridPane hgap="14" vgap="12" maxWidth="820">
                        <columnConstraints>
                            <ColumnConstraints minWidth="220" prefWidth="240"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Días para «por vencer»" styleClass="campo-label" GridPane.rowIndex="0"/>
                        <TextField
                            fx:id="diasVencimiento"
                            promptText="60"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                        <Label text="Días del recordatorio preventivo" styleClass="campo-label" GridPane.rowIndex="1"/>
                        <TextField
                            fx:id="diasRecordatorio"
                            promptText="3"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                    </GridPane>
                    <Label
                        text="El recordatorio preventivo incluye cuotas que vencen dentro de esos días."
                        styleClass="campo-ayuda"
                        wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Semáforo">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="16" styleClass="pagina">
                    <GridPane hgap="14" vgap="12" maxWidth="820">
                        <columnConstraints>
                            <ColumnConstraints minWidth="220" prefWidth="240"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Umbral de atraso leve (días)" styleClass="campo-label" GridPane.rowIndex="0"/>
                        <TextField
                            fx:id="umbralLeve"
                            promptText="15"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                        <Label text="Cuotas vencidas para marcar rojo" styleClass="campo-label" GridPane.rowIndex="1"/>
                        <TextField
                            fx:id="cuotasRojo"
                            promptText="2"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                    </GridPane>
                    <Label
                        text="Verde: al día. Ámbar: atraso leve. Rojo: supera el umbral de días o la cantidad de cuotas."
                        styleClass="campo-ayuda"
                        wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Plantillas">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="14" styleClass="pagina">
                    <Label
                        text="Marcadores disponibles: {nombre} {inmueble} {arrendador} {contrato} {fecha_fin} {dias} {concepto} {monto} {mora} {vencimiento}"
                        styleClass="pagina-subtitulo"
                        wrapText="true"/>
                    <VBox spacing="6">
                        <Label text="Recordatorio preventivo" styleClass="campo-label"/>
                        <TextArea fx:id="plantillaPreventivo" prefRowCount="5" wrapText="true"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Recordatorio de cuota vencida" styleClass="campo-label"/>
                        <TextArea fx:id="plantillaVencido" prefRowCount="5" wrapText="true"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Aviso de fin de contrato" styleClass="campo-label"/>
                        <TextArea fx:id="plantillaFinContrato" prefRowCount="4" wrapText="true"/>
                    </VBox>
                    <Button
                        text="Restaurar textos por defecto"
                        onAction="#onRestaurarPlantillas"
                        styleClass="requiere-admin"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Seguridad">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="16" styleClass="pagina">
                    <GridPane hgap="14" vgap="12" maxWidth="820">
                        <columnConstraints>
                            <ColumnConstraints minWidth="220" prefWidth="240"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label text="Minutos de inactividad" styleClass="campo-label" GridPane.rowIndex="0"/>
                        <TextField
                            fx:id="inactividad"
                            promptText="15"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"
                            maxWidth="240"/>
                    </GridPane>
                    <Label
                        text="Tras esos minutos sin actividad se muestra la pantalla de bloqueo. Usa 0 para desactivar el bloqueo."
                        styleClass="campo-ayuda"
                        wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Respaldo">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="12" styleClass="pagina">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Respaldo y restauración" styleClass="pagina-titulo"/>
                            <Label
                                text="Copia consistente de la base de datos y restauración con validación previa."
                                styleClass="pagina-subtitulo"/>
                        </VBox>
                        <Button
                            text="Crear respaldo ahora"
                            onAction="#onCrearRespaldo"
                            styleClass="boton-primario,requiere-admin"/>
                        <Button text="Restaurar respaldo" onAction="#onRestaurarRespaldo" styleClass="requiere-admin"/>
                    </HBox>
                    <Label fx:id="rutaDatos" styleClass="campo-ayuda" wrapText="true"/>
                    <Label
                        text="Respaldos automáticos (se conservan los últimos 10 al cerrar la aplicación)"
                        styleClass="pagina-subtitulo"/>
                    <TableView fx:id="tablaRespaldos" VBox.vgrow="ALWAYS" styleClass="tabla" prefHeight="380">
                        <columns>
                            <TableColumn fx:id="colRespNombre" text="Archivo" prefWidth="420"/>
                            <TableColumn fx:id="colRespFecha" text="Fecha" prefWidth="180"/>
                            <TableColumn fx:id="colRespTamano" text="Tamaño" prefWidth="130"/>
                        </columns>
                    </TableView>
                    <Label
                        text="Al restaurar se crea un respaldo de seguridad en la carpeta de respaldos y luego se cierra la aplicación."
                        styleClass="campo-ayuda"
                        wrapText="true"/>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Usuarios">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="12" styleClass="pagina">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Usuarios" styleClass="pagina-titulo"/>
                            <Label
                                text="Solo el administrador puede crear, editar y restablecer contraseñas."
                                styleClass="pagina-subtitulo"/>
                        </VBox>
                        <Button
                            text="Nuevo usuario"
                            onAction="#onNuevoUsuario"
                            styleClass="boton-primario,requiere-admin"/>
                        <Button text="Editar" onAction="#onEditarUsuario" styleClass="requiere-admin"/>
                        <Button
                            text="Activar / desactivar"
                            onAction="#onDesactivarUsuario"
                            styleClass="requiere-admin"/>
                        <Button
                            text="Restablecer contraseña"
                            onAction="#onRestablecerPassword"
                            styleClass="requiere-admin"/>
                    </HBox>
                    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS" styleClass="tabla" prefHeight="420">
                        <columns>
                            <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="150"/>
                            <TableColumn fx:id="colNombreUsuario" text="Nombre" prefWidth="230"/>
                            <TableColumn fx:id="colRolUsuario" text="Rol" prefWidth="140"/>
                            <TableColumn fx:id="colEstadoUsuario" text="Estado" prefWidth="120"/>
                            <TableColumn fx:id="colUltimoAcceso" text="Último acceso" prefWidth="170"/>
                        </columns>
                    </TableView>
                </VBox>
            </ScrollPane>
        </Tab>
        <Tab text="Auditoría">
            <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                <VBox spacing="12" styleClass="pagina">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="Auditoría" styleClass="pagina-titulo"/>
                            <Label
                                text="Operaciones sensibles registradas por usuario y fecha. No contiene contraseñas."
                                styleClass="pagina-subtitulo"/>
                        </VBox>
                        <Button text="Exportar Excel" onAction="#onExportarAuditoria"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <DatePicker fx:id="audDesde" promptText="Desde"/>
                        <DatePicker fx:id="audHasta" promptText="Hasta"/>
                        <TextField fx:id="audUsuario" promptText="Usuario" prefWidth="150"/>
                        <ComboBox fx:id="audAccion" promptText="Acción" prefWidth="220"/>
                        <Button text="Buscar" onAction="#onBuscarAuditoria" styleClass="boton-primario"/>
                        <Button text="Limpiar" onAction="#onLimpiarAuditoria"/>
                    </HBox>
                    <TableView fx:id="tablaAuditoria" VBox.vgrow="ALWAYS" styleClass="tabla" prefHeight="430">
                        <columns>
                            <TableColumn fx:id="colAudFecha" text="Fecha" prefWidth="150"/>
                            <TableColumn fx:id="colAudUsuario" text="Usuario" prefWidth="140"/>
                            <TableColumn fx:id="colAudAccion" text="Acción" prefWidth="190"/>
                            <TableColumn fx:id="colAudEntidad" text="Entidad" prefWidth="130"/>
                            <TableColumn fx:id="colAudDetalle" text="Detalle" prefWidth="360"/>
                        </columns>
                    </TableView>
                </VBox>
            </ScrollPane>
        </Tab>
    </TabPane>
</VBox>
