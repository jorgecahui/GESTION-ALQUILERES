<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ejemplo.alquileres.controller.PagosController" spacing="16" styleClass="pagina">
    <HBox><VBox HBox.hgrow="ALWAYS"><Label text="Pagos" styleClass="pagina-titulo"/><Label text="Historial de recibos emitidos y anulados." styleClass="pagina-subtitulo"/></VBox><Button text="Nuevo pago" onAction="#onNuevo" styleClass="boton-primario"/><Button text="Actualizar" onAction="#onFiltrar"/></HBox>
    <HBox spacing="12"><VBox styleClass="kpi" HBox.hgrow="ALWAYS"><Label text="Total cobrado"/><Label fx:id="totalCobrado" text="S/ 0.00" styleClass="kpi-valor"/></VBox><VBox styleClass="kpi" HBox.hgrow="ALWAYS"><Label text="Recibos emitidos"/><Label fx:id="numeroRecibos" text="0" styleClass="kpi-valor"/></VBox><VBox styleClass="kpi" HBox.hgrow="ALWAYS"><Label text="Mora cobrada"/><Label fx:id="moraCobrada" text="S/ 0.00" styleClass="kpi-valor"/></VBox><VBox styleClass="kpi" HBox.hgrow="ALWAYS"><Label text="Anulados"/><Label fx:id="anulados" text="0" styleClass="kpi-valor"/></VBox></HBox>
    <VBox spacing="10" styleClass="tarjeta" VBox.vgrow="ALWAYS"><HBox spacing="8"><DatePicker fx:id="desde" promptText="Desde"/><DatePicker fx:id="hasta" promptText="Hasta"/><Button text="Filtrar" onAction="#onFiltrar"/><Region HBox.hgrow="ALWAYS"/><Button text="Exportar Excel" onAction="#onExportar"/><Button text="Recibo PDF" onAction="#onPdf"/><Button text="Anular" onAction="#onAnular"/></HBox><TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="tabla"><columns><TableColumn fx:id="colRecibo" text="Recibo" prefWidth="145"/><TableColumn fx:id="colFecha" text="Fecha" prefWidth="105"/><TableColumn fx:id="colArrendatario" text="Arrendatario" prefWidth="210"/><TableColumn fx:id="colInmueble" text="Inmueble" prefWidth="180"/><TableColumn fx:id="colMedio" text="Medio" prefWidth="130"/><TableColumn fx:id="colTotal" text="Total" prefWidth="120"/><TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/></columns><placeholder><Label text="Sin pagos en el periodo."/></placeholder></TableView></VBox>
</VBox>
