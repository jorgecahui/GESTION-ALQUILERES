<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ejemplo.alquileres.controller.PagoFormController" spacing="18" styleClass="pagina">
    <VBox spacing="16" HBox.hgrow="ALWAYS">
        <VBox><Label text="Nuevo pago" styleClass="pagina-titulo"/><Label text="Aplica el pago a las cuotas más antiguas; la mora se cobra primero." styleClass="pagina-subtitulo"/></VBox>
        <VBox spacing="10" styleClass="tarjeta"><Label text="Contrato" styleClass="drawer-titulo"/><ComboBox fx:id="contrato" promptText="Selecciona por código, arrendatario o inmueble" maxWidth="Infinity"/><Label fx:id="resumenContrato" text="Selecciona un contrato." wrapText="true"/><HBox fx:id="semaforoContrato"/></VBox>
        <VBox spacing="10" styleClass="tarjeta" VBox.vgrow="ALWAYS"><HBox><VBox HBox.hgrow="ALWAYS"><Label text="Cuotas a cobrar" styleClass="drawer-titulo"/><Label text="La distribución automática prioriza mora y luego capital." styleClass="pagina-subtitulo"/></VBox><TextField fx:id="montoRecibido" promptText="Monto recibido (S/)" prefWidth="150"/><Button text="Aplicar monto" onAction="#onAplicarMonto" styleClass="requiere-gestion"/><Button text="Pagar todo" onAction="#onPagarTodo" styleClass="requiere-gestion"/></HBox><HBox spacing="12"><CheckBox fx:id="permitirAdelantos" text="Permitir adelantos" onAction="#onCambiarCondonacion"/><CheckBox fx:id="condonarMora" text="Condonar mora de las cuotas imputadas" onAction="#onCambiarCondonacion" styleClass="requiere-admin"/><TextField fx:id="motivoCondonacion" promptText="Motivo de condonación" HBox.hgrow="ALWAYS" styleClass="requiere-admin"/></HBox><TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="tabla"><columns><TableColumn fx:id="colConcepto" text="Concepto" prefWidth="220"/><TableColumn fx:id="colVencimiento" text="Vencimiento" prefWidth="110"/><TableColumn fx:id="colCapital" text="Capital" prefWidth="110"/><TableColumn fx:id="colMora" text="Mora" prefWidth="100"/><TableColumn fx:id="colCondonada" text="Mora condonada" prefWidth="130"/></columns><placeholder><Label text="Selecciona un contrato para ver sus cuotas pendientes."/></placeholder></TableView></VBox>
    </VBox>
    <VBox spacing="12" prefWidth="310" styleClass="tarjeta"><Label text="Resumen" styleClass="drawer-titulo"/><Label text="Fecha de pago"/><DatePicker fx:id="fecha" maxWidth="Infinity"/><Label text="Medio de pago"/><ComboBox fx:id="medio" maxWidth="Infinity"/><Label text="Referencia"/><TextField fx:id="referencia" promptText="N° de operación (opcional)"/><Label text="Observación"/><TextArea fx:id="observacion" prefRowCount="3" wrapText="true"/><Separator/><HBox><Label text="Capital" HBox.hgrow="ALWAYS"/><Label fx:id="totalCapital" text="S/ 0.00"/></HBox><HBox><Label text="Mora" HBox.hgrow="ALWAYS"/><Label fx:id="totalMora" text="S/ 0.00"/></HBox><HBox><Label text="Mora condonada" HBox.hgrow="ALWAYS"/><Label fx:id="totalCondonada" text="S/ 0.00"/></HBox><HBox><Label text="TOTAL A PAGAR" styleClass="drawer-titulo" HBox.hgrow="ALWAYS"/><Label fx:id="totalPago" text="S/ 0.00" styleClass="kpi-valor"/></HBox><Button text="Estado de cuenta" onAction="#onEstadoCuenta" maxWidth="Infinity"/><Button text="Registrar pago" onAction="#onRegistrar" maxWidth="Infinity" styleClass="boton-primario,requiere-gestion"/></VBox>
</HBox>
