<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.ejemplo.alquileres.controller.JlccTipoInmuebleController">
    <HBox spacing="18" styleClass="pagina">
        <VBox spacing="16" HBox.hgrow="ALWAYS">
            <HBox>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Tipos de inmueble" styleClass="pagina-titulo"/>
                    <Label text="Clasifica los inmuebles del catálogo." styleClass="pagina-subtitulo"/>
                </VBox>
                <Button text="Nuevo tipo" onAction="#jlccOnNuevo" styleClass="boton-primario,requiere-gestion"/>
            </HBox>
            <HBox spacing="10">
                <TextField fx:id="buscar" promptText="Buscar por nombre o código" HBox.hgrow="ALWAYS"/>
                <Button text="Editar" onAction="#jlccOnEditar" styleClass="requiere-gestion"/>
                <Button
                    fx:id="btnEliminarDesactivar"
                    text="Eliminar / desactivar"
                    onAction="#jlccOnEliminar"
                    styleClass="requiere-gestion"
                    visible="false"
                    managed="false"/>
                <Button
                    fx:id="btnReactivar"
                    text="Reactivar"
                    onAction="#jlccOnReactivar"
                    styleClass="requiere-gestion"
                    visible="false"
                    managed="false"/>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="tabla">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="150"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="280"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
    <Region
        fx:id="overlay"
        visible="false"
        managed="false"
        pickOnBounds="true"
        styleClass="overlay"
        onMouseClicked="#jlccOnCerrar"/>
    <VBox
        fx:id="drawer"
        visible="false"
        managed="false"
        prefWidth="560"
        minWidth="560"
        maxWidth="560"
        maxHeight="Infinity"
        styleClass="drawer,panel-formulario"
        StackPane.alignment="TOP_RIGHT">
        <HBox styleClass="drawer-header">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titulo" styleClass="drawer-titulo"/>
                <Label text="Clasifica los inmuebles del catálogo" styleClass="drawer-subtitulo"/>
            </VBox>
            <Button onAction="#jlccOnCerrar" styleClass="drawer-cerrar" focusTraversable="false">
                <graphic>
                    <FontIcon iconLiteral="fth-x"/>
                </graphic>
                <tooltip>
                    <Tooltip text="Cerrar"/>
                </tooltip>
            </Button>
        </HBox>
        <ScrollPane
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            VBox.vgrow="ALWAYS"
            styleClass="drawer-scroll">
            <VBox styleClass="drawer-body">
                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="40"/>
                        <ColumnConstraints percentWidth="60"/>
                    </columnConstraints>
                    <VBox styleClass="campo" GridPane.columnIndex="0">
                        <HBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Código" styleClass="campo-label"/>
                            <Label text="*" styleClass="campo-requerido"/>
                        </HBox>
                        <TextField fx:id="codigo" promptText="TI-DEP" maxWidth="Infinity"/>
                        <Label fx:id="errorCodigo" styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                    <VBox styleClass="campo" GridPane.columnIndex="1">
                        <HBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Nombre" styleClass="campo-label"/>
                            <Label text="*" styleClass="campo-requerido"/>
                        </HBox>
                        <TextField fx:id="nombre" promptText="Ej. Departamento" maxWidth="Infinity"/>
                        <Label fx:id="errorNombre" styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                </GridPane>
                <VBox styleClass="campo">
                    <Label text="Descripción" styleClass="campo-label"/>
                    <TextArea
                        fx:id="descripcion"
                        promptText="Descripción del tipo de inmueble (opcional)"
                        prefRowCount="4"
                        wrapText="true"
                        maxWidth="Infinity"/>
                </VBox>
            </VBox>
        </ScrollPane>
        <HBox styleClass="drawer-footer">
            <Button text="Cancelar" onAction="#jlccOnCerrar" styleClass="button-outlined"/>
            <Button text="Guardar tipo" onAction="#jlccOnGuardar" styleClass="boton-primario,requiere-gestion"/>
        </HBox>
    </VBox>
</StackPane>
