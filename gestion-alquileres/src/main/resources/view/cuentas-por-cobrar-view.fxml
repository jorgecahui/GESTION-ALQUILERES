<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.ejemplo.alquileres.controller.JlccCuentasPorCobrarController"
    spacing="16"
    styleClass="pagina">
    <HBox>
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Cuentas por cobrar" styleClass="pagina-titulo"/>
            <Label text="Cuotas pendientes, mora estimada y prioridad de cobranza." styleClass="pagina-subtitulo"/>
        </VBox>
        <Button text="Exportar Excel" onAction="#jlccOnExportar"/>
        <Button text="Recordar a todos los vencidos" onAction="#jlccOnRecordarTodos" styleClass="requiere-gestion"/>
    </HBox>
    <HBox spacing="12">
        <VBox styleClass="kpi" HBox.hgrow="ALWAYS">
            <Label text="Total por cobrar"/>
            <Label fx:id="totalCobrar" text="S/ 0.00" styleClass="kpi-valor"/>
        </VBox>
        <VBox styleClass="kpi" HBox.hgrow="ALWAYS">
            <Label text="Vencido"/>
            <Label fx:id="totalVencido" text="S/ 0.00" styleClass="kpi-valor"/>
        </VBox>
        <VBox styleClass="kpi" HBox.hgrow="ALWAYS">
            <Label text="Vence en 7 días"/>
            <Label fx:id="porVencer" text="S/ 0.00" styleClass="kpi-valor"/>
        </VBox>
        <VBox styleClass="kpi" HBox.hgrow="ALWAYS">
            <Label text="Contratos morosos"/>
            <Label fx:id="contratosMorosos" text="0" styleClass="kpi-valor"/>
        </VBox>
    </HBox>
    <VBox spacing="10" styleClass="tarjeta" VBox.vgrow="ALWAYS">
        <HBox spacing="8">
            <TextField fx:id="buscar" promptText="Buscar arrendatario, inmueble o concepto" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="filtro" prefWidth="170"/>
            <Button text="Estado de cuenta" onAction="#jlccOnEstadoCuenta"/>
            <Button text="Recordar" onAction="#jlccOnRecordar" styleClass="requiere-gestion"/>
            <Button text="Cobrar" onAction="#jlccOnCobrar" styleClass="boton-primario,requiere-gestion"/>
        </HBox>
        <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="tabla">
            <columns>
                <TableColumn fx:id="colArrendatario" text="Arrendatario" prefWidth="180"/>
                <TableColumn fx:id="colInmueble" text="Inmueble" prefWidth="150"/>
                <TableColumn fx:id="colConcepto" text="Concepto" prefWidth="160"/>
                <TableColumn fx:id="colVencimiento" text="Vencimiento" prefWidth="100"/>
                <TableColumn fx:id="colDias" text="Días" prefWidth="60"/>
                <TableColumn fx:id="colSaldo" text="Saldo" prefWidth="105"/>
                <TableColumn fx:id="colMora" text="Mora estimada" prefWidth="115"/>
                <TableColumn fx:id="colTotal" text="Total" prefWidth="105"/>
                <TableColumn fx:id="colSemaforo" text="Semáforo" prefWidth="110"/>
                <TableColumn fx:id="colUltimoRecordatorio" text="Último recordatorio" prefWidth="140"/>
            </columns>
            <placeholder>
                <Label text="Sin cuotas pendientes."/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
