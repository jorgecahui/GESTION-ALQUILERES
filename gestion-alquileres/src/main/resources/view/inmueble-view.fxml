<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ejemplo.alquileres.controller.InmuebleController">

    <HBox spacing="18" styleClass="pagina">
        <VBox spacing="16" HBox.hgrow="ALWAYS">
            <HBox>
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Inmuebles" styleClass="pagina-titulo"/>
                    <Label text="Disponibilidad, propietario y renta referencial." styleClass="pagina-subtitulo"/>
                </VBox>
                <Button text="Nuevo inmueble" onAction="#onNuevo" styleClass="boton-primario"/>
            </HBox>

            <HBox spacing="10">
                <TextField fx:id="buscar" promptText="Buscar código, nombre o dirección" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="filtroEstado" promptText="Estado"/>
                <ComboBox fx:id="filtroTipo" prefWidth="180" promptText="Tipo"/>
                <Button text="Editar" onAction="#onEditar"/>
                <Button text="Ver ficha" onAction="#onFicha"/>
                <Button text="Exportar Excel" onAction="#onExportar"/>
            </HBox>

            <TableView fx:id="tabla" VBox.vgrow="ALWAYS" styleClass="tabla">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="110"/>
                    <TableColumn fx:id="colNombre" text="Inmueble" prefWidth="250"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130"/>
                    <TableColumn fx:id="colPropietario" text="Propietario" prefWidth="170"/>
                    <TableColumn fx:id="colRenta" text="Renta" prefWidth="120"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>

    <Region fx:id="overlay" visible="false" managed="false" pickOnBounds="true" styleClass="overlay" onMouseClicked="#onCerrar"/>

    <VBox fx:id="ficha" visible="false" managed="false" prefWidth="470" minWidth="470" maxWidth="470"
          maxHeight="Infinity" styleClass="drawer,ficha-inmueble" StackPane.alignment="TOP_RIGHT">
        <Label fx:id="fichaTitulo" text="Ficha del inmueble" styleClass="drawer-titulo"/>
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab text="Datos">
                <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                    <VBox styleClass="pagina">
                        <Label fx:id="fichaDatos" wrapText="true"/>
                    </VBox>
                </ScrollPane>
            </Tab>
            <Tab text="Contratos">
                <TableView fx:id="fichaContratos" styleClass="tabla">
                    <columns>
                        <TableColumn fx:id="colFichaContratoCodigo" text="Código" prefWidth="85"/>
                        <TableColumn fx:id="colFichaContratoArrendatario" text="Arrendatario" prefWidth="125"/>
                        <TableColumn fx:id="colFichaContratoVigencia" text="Vigencia" prefWidth="120"/>
                        <TableColumn fx:id="colFichaContratoEstado" text="Estado" prefWidth="90"/>
                        <TableColumn fx:id="colFichaContratoRenta" text="Renta" prefWidth="80"/>
                    </columns>
                    <placeholder><Label text="Sin contratos registrados."/></placeholder>
                </TableView>
            </Tab>
            <Tab text="Mantenimiento">
                <TableView fx:id="fichaMantenimientos" styleClass="tabla">
                    <columns>
                        <TableColumn fx:id="colFichaMantCodigo" text="Código" prefWidth="90"/>
                        <TableColumn fx:id="colFichaMantTitulo" text="Título" prefWidth="150"/>
                        <TableColumn fx:id="colFichaMantEstado" text="Estado" prefWidth="95"/>
                        <TableColumn fx:id="colFichaMantPrioridad" text="Prioridad" prefWidth="85"/>
                        <TableColumn fx:id="colFichaMantCosto" text="Costo" prefWidth="80"/>
                    </columns>
                    <placeholder><Label text="Sin incidencias registradas."/></placeholder>
                </TableView>
            </Tab>
            <Tab text="Ingresos y gastos">
                <ScrollPane fitToWidth="true" styleClass="pagina-scroll">
                    <VBox styleClass="pagina">
                        <Label fx:id="fichaFinanzas" wrapText="true"/>
                    </VBox>
                </ScrollPane>
            </Tab>
        </TabPane>
        <Button text="Cerrar" onAction="#onCerrarFicha"/>
    </VBox>

    <VBox fx:id="drawer" visible="false" managed="false" prefWidth="560" minWidth="560" maxWidth="560"
          maxHeight="Infinity" styleClass="drawer,panel-formulario" StackPane.alignment="TOP_RIGHT">
        <HBox styleClass="drawer-header">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label fx:id="titulo" styleClass="drawer-titulo"/>
                <Label text="Datos principales del inmueble" styleClass="drawer-subtitulo"/>
            </VBox>
            <Button onAction="#onCerrar" styleClass="drawer-cerrar" focusTraversable="false">
                <graphic><FontIcon iconLiteral="fth-x"/></graphic>
                <tooltip><Tooltip text="Cerrar"/></tooltip>
            </Button>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="drawer-scroll">
            <VBox styleClass="drawer-body">

                <VBox spacing="14">
                    <VBox styleClass="campo">
                        <HBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Código" styleClass="campo-label"/>
                            <Label text="*" styleClass="campo-requerido"/>
                        </HBox>
                        <TextField fx:id="codigo" promptText="INM-0001" maxWidth="Infinity"/>
                        <Label fx:id="errorCodigo" styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>

                    <VBox styleClass="campo">
                        <HBox spacing="3" alignment="CENTER_LEFT">
                            <Label text="Nombre o alias" styleClass="campo-label"/>
                            <Label text="*" styleClass="campo-requerido"/>
                        </HBox>
                        <TextField fx:id="nombre" promptText="Ej. Depa 301 · Av. Lima" maxWidth="Infinity"/>
                        <Label fx:id="errorNombre" styleClass="campo-error" visible="false" managed="false"/>
                    </VBox>
                </VBox>

                <Region styleClass="divisor-form" maxWidth="Infinity" prefHeight="1" minHeight="1" maxHeight="1"/>

                <VBox spacing="14">
                    <GridPane hgap="14" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox styleClass="campo" GridPane.columnIndex="0">
                            <Label text="Tipo" styleClass="campo-label"/>
                            <ComboBox fx:id="tipo" promptText="Selecciona un tipo" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.columnIndex="1">
                            <Label text="Propietario" styleClass="campo-label"/>
                            <ComboBox fx:id="propietario" promptText="Selecciona un propietario" maxWidth="Infinity"/>
                        </VBox>
                    </GridPane>

                    <VBox styleClass="campo">
                        <Label text="Dirección" styleClass="campo-label"/>
                        <TextField fx:id="direccion" promptText="Av. / Calle, número, referencia" maxWidth="Infinity"/>
                    </VBox>
                </VBox>

                <Region styleClass="divisor-form" maxWidth="Infinity" prefHeight="1" minHeight="1" maxHeight="1"/>

                <VBox spacing="10">
                    <Label text="UBICACIÓN" styleClass="seccion-form"/>
                    <VBox styleClass="campo">
                        <Label text="Referencia" styleClass="campo-label"/>
                        <TextField fx:id="referencia" promptText="Ej. Frente al parque, torre B" maxWidth="Infinity"/>
                    </VBox>
                    <GridPane hgap="14" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox styleClass="campo" GridPane.columnIndex="0">
                            <Label text="Distrito" styleClass="campo-label"/>
                            <TextField fx:id="distrito" promptText="Ej. Miraflores" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.columnIndex="1">
                            <Label text="Provincia" styleClass="campo-label"/>
                            <TextField fx:id="provincia" promptText="Ej. Lima" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label text="Departamento" styleClass="campo-label"/>
                            <TextField fx:id="departamento" promptText="Ej. Lima" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="Piso" styleClass="campo-label"/>
                            <TextField fx:id="piso" promptText="Ej. 3, PB, Sótano" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.rowIndex="2" GridPane.columnIndex="0">
                            <Label text="Nivel" styleClass="campo-label"/>
                            <TextField fx:id="nivel" promptText="0 = planta baja" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.rowIndex="2" GridPane.columnIndex="1">
                            <Label text="Orden" styleClass="campo-label"/>
                            <TextField fx:id="orden" promptText="Desde 1" maxWidth="Infinity"/>
                        </VBox>
                    </GridPane>
                    <Label text="Nivel 0 = planta baja; los negativos son subsuelo. El orden va de izquierda a derecha."
                           styleClass="campo-ayuda" wrapText="true"/>
                </VBox>

                <Region styleClass="divisor-form" maxWidth="Infinity" prefHeight="1" minHeight="1" maxHeight="1"/>

                <VBox spacing="10">
                    <Label text="CARACTERÍSTICAS" styleClass="seccion-form"/>
                    <GridPane hgap="14" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox styleClass="campo" GridPane.columnIndex="0">
                            <Label text="Dormitorios" styleClass="campo-label"/>
                            <TextField fx:id="dormitorios" promptText="0" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.columnIndex="1">
                            <Label text="Baños" styleClass="campo-label"/>
                            <TextField fx:id="banos" promptText="0" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.rowIndex="1" GridPane.columnIndex="0">
                            <Label text="Estacionamientos" styleClass="campo-label"/>
                            <TextField fx:id="estacionamientos" promptText="0" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.rowIndex="1" GridPane.columnIndex="1">
                            <Label text="Amoblado" styleClass="campo-label"/>
                            <CheckBox fx:id="amoblado" text="Incluye muebles"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <Region styleClass="divisor-form" maxWidth="Infinity" prefHeight="1" minHeight="1" maxHeight="1"/>

                <VBox spacing="10">
                    <Label text="DETALLES" styleClass="seccion-form"/>
                    <VBox styleClass="campo">
                        <Label text="Servicios incluidos" styleClass="campo-label"/>
                        <TextArea fx:id="serviciosIncluidos" promptText="Ej. Agua, luz, internet, mantenimiento"
                                  prefRowCount="2" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="campo">
                        <Label text="Descripción" styleClass="campo-label"/>
                        <TextArea fx:id="descripcion" promptText="Observaciones generales del inmueble"
                                  prefRowCount="3" wrapText="true"/>
                    </VBox>
                </VBox>

                <Region styleClass="divisor-form" maxWidth="Infinity" prefHeight="1" minHeight="1" maxHeight="1"/>

                <VBox spacing="14">
                    <GridPane hgap="14" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox styleClass="campo" GridPane.columnIndex="0">
                            <Label text="Área (m²)" styleClass="campo-label"/>
                            <TextField fx:id="area" promptText="0.00" maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="campo" GridPane.columnIndex="1">
                            <Label text="Renta referencial" styleClass="campo-label"/>
                            <HBox fx:id="campoRenta" styleClass="campo-moneda" alignment="CENTER_LEFT" spacing="8">
                                <Label text="S/" styleClass="prefijo-moneda"/>
                                <TextField fx:id="renta" promptText="0.00" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            </HBox>
                        </VBox>
                    </GridPane>

                    <VBox styleClass="campo">
                        <Label text="Estado" styleClass="campo-label"/>
                        <ComboBox fx:id="estado" promptText="Estado" maxWidth="Infinity"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>

        <HBox styleClass="drawer-footer">
            <Button text="Cancelar" onAction="#onCerrar" styleClass="button-outlined"/>
            <Button text="Guardar inmueble" onAction="#onGuardar" styleClass="boton-primario"/>
        </HBox>
    </VBox>
</StackPane>
